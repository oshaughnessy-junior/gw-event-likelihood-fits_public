cff-version: 1.2.0
message: "If you use these fits, please cite them as below."
type: dataset
title: "Gravitational-wave event likelihood fits"
version: "1.0.0"
license: CC-BY-4.0
abstract: "Fitted likelihood models for gravitational-wave events, built only from public LVK posterior releases. Each fit is bound to its public source file by a certificate and carries a validation record. No posterior samples, distance grids or integration banks are included."
repository: "https://github.com/oshaughnessy-junior/gw-event-likelihood-fits_public"
keywords:
  - "gravitational waves"
  - "likelihood"
  - "parameter estimation"
  - "RIFT"
authors:
  - family-names: "O'Shaughnessy"
    given-names: "Richard"
    affiliation: "Rochester Institute of Technology"
    orcid: "https://orcid.org/0000-0001-5832-8517"
